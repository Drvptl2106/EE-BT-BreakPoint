{
  "name": "breakpoint",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Live break tracking for a contact-centre team. Pilot build.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.js",
    "test:db": "bash tests/db/run.sh",
    "test:security": "node --test tests/security/live.test.mjs",
    "test:all": "npm test && npm run test:db",
    "test:e2e": "python3 tests/e2e/smoke.py http://localhost:8080",
    "logins": "node scripts/create_logins.mjs"
  },
  "license": "UNLICENSED"
}
