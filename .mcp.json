{
  "mcpServers": {
    "perplexity": {
      "type": "http",
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PERPLEXITY_API_KEY}"
      }
    },
    "composio": {
      "type": "http",
      "url": "${COMPOSIO_MCP_URL}",
      "headers": {
        "X-API-Key": "${COMPOSIO_API_KEY}"
      }
    }
  }
}
